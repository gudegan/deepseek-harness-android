<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 前台服务 + 保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 保活白名单引导 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 唤醒/定位飞书 App 接收日志分享（Android 11+ 需声明 package visibility，即用户提到的“应用权限”） -->
    <queries>
        <package android:name="com.ss.android.lark" />
        <package android:name="com.larksuite.mobile" />
        <package android:name="com.bytedance.lark" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".DshApp"
        android:allowBackup="true"
        android:icon="@drawable/dsh_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DshShell">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DshShell">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask">
        </activity>

        <!-- 前台服务：常驻保活 dsh 进程 -->
        <service
            android:name=".service.HarnessService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
